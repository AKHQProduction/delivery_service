          "rawQuery": true,
          "rawSql": "SELECT \n  c.full_name,\n  p.number as phone,\n  a.address,\n  c.created_at\nFROM clients c\nLEFT JOIN LATERAL (\n  SELECT number FROM client_phones WHERE client_id = c.id LIMIT 1\n) p ON true\nLEFT JOIN LATERAL (\n  SELECT street || ', ' || house || COALESCE(', кв.' || apartment, '') as address FROM client_addresses WHERE client_id = c.id LIMIT 1\n) a ON true\nORDER BY c.created_at DESC\nLIMIT 20;",
