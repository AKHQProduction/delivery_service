          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  c.full_name as client,\n  o.date,\n  o.delivery_start_time,\n  o.delivery_end_time,\n  o.delivery_phone,\n  o.payment_method,\n  o.is_paid,\n  o.comment,\n  o.created_at\nFROM orders o\nJOIN clients c ON c.id = o.client_id\nORDER BY o.created_at DESC\nLIMIT 20;",
